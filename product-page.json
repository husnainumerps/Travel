    "testimonials_zwxK98": {
      "type": "testimonials",
      "blocks": {
        "column_cAi9qE": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/before-after-legs-1.webp",
            "title": "I was intimidated by squats at the gym",
            "text": "<p><em>The gym always felt overwhelming and I was worried about my form. This squat machine gave me the confidence to work out at home with perfect technique. My legs have never been stronger and I actually look forward to leg day now!</em></p>",
            "author": "— <strong>Jessica M., 28 | Beginner Fitness Enthusiast</strong>"
          }
        },
        "column_BgMWyF": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/transformation-glutes.webp",
            "title": "Better than my expensive gym membership",
            "text": "<p><em>I was spending $80/month on a gym I barely used. This machine paid for itself in just a few months and gives me better workouts than any squat rack. The guided movement helps me maintain perfect form every single rep.</em></p>",
            "author": "— <strong>Marcus T., 35</strong>"
          }
        },
        "column_PPMBaQ": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/fitness-transformation-female.webp",
            "title": "My legs got toned faster than ever",
            "text": "<p><em>I've tried countless leg workouts and nothing gave me results like this squat machine. The adjustable resistance means I'm always challenged, and my glutes and quads are more defined than they've ever been. It's incredible!</em></p>",
            "author": "— <strong>Amanda R., 32</strong>"
          }
        },
        "column_7UNb4f": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/muscle-gain-legs.webp",
            "title": "My knee pain disappeared completely.",
            "text": "<p><em>I avoided squats for years due to knee issues from poor form. This machine's guided movement completely eliminated my pain while actually strengthening my knees. Now I can squat pain-free and my legs are the strongest they've ever been.</em></p>",
            "author": "— <strong>Robert K., 45</strong>"
          }
        }
      ],
      "block_order": [
        "column_cAi9qE",
        "column_BgMWyF",
        "column_PPMBaQ",
        "column_7UNb4f"
      ],
